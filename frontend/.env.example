# API Ghosty, consommée par le navigateur et par le process SSR.
VITE_GHOSTY_API_URL=http://api.ghosty.local/api/

# URL à ouvrir dans le navigateur, affichée au démarrage du serveur SSR.
# Doit être sur le même site que l'API pour que le cookie d'auth soit joint.
# @see ../backend/memory-bank/decisions/ADR-04-token-en-cookie-httponly.md
SSR_PUBLIC_URL=http://app.ghosty.local:5173
